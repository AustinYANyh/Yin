<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\Yin\Source\Hasselblad.png" Link="Source\Hasselblad.png" />
    <Resource Include="..\Yin\Source\Hasselblad_white.png" Link="Source\Hasselblad_white.png" />
    <Resource Include="..\Yin\Source\FZZJ-ZDFCSJW.TTF" Link="Source\FZZJ-ZDFCSJW.TTF" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Yin\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\Yin\Services\ExifService.cs" Link="Services\ExifService.cs" />
    <Compile Include="..\Yin\Services\RenderingService.cs" Link="Services\RenderingService.cs" />
    <Compile Include="..\Yin\Services\RenderContextFactory.cs" Link="Services\RenderContextFactory.cs" />
    <Compile Include="..\Yin\Services\TemplateService.cs" Link="Services\TemplateService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
  </ItemGroup>

</Project>
